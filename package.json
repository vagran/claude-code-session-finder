{
  "name": "claude-code-session-finder",
  "displayName": "Claude Code Sessions & Agents",
  "description": "See which Claude Code sessions are running or waiting on you, browse and search every session's content, and open any of them in a tab or the right panel.",
  "version": "0.8.0",
  "license": "MIT",
  "publisher": "shobhitg",
  "repository": {
    "type": "git",
    "url": "https://github.com/shobhitg/claude-code-session-finder"
  },
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "Other"
  ],
  "icon": "resources/icon.png",
  "keywords": [
    "claude",
    "claude code",
    "sessions",
    "search",
    "history",
    "status"
  ],
  "main": "./dist/extension.js",
  "extensionDependencies": [
    "anthropic.claude-code"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "sessionFinder.search",
        "title": "Claude: Search Sessions",
        "icon": "$(search)"
      },
      {
        "command": "sessionFinder.filterSessions",
        "title": "Claude: Filter Sessions",
        "icon": "$(search)"
      },
      {
        "command": "sessionFinder.showAllProjects",
        "title": "Claude: Sessions — Show All Projects",
        "icon": "$(filter-filled)"
      },
      {
        "command": "sessionFinder.showThisWorkspace",
        "title": "Claude: Sessions — Show This Workspace Only",
        "icon": "$(filter)"
      },
      {
        "command": "sessionFinder.showSessions",
        "title": "Claude: Show Sessions"
      },
      {
        "command": "sessionFinder.refresh",
        "title": "Claude: Refresh Sessions",
        "icon": "$(refresh)"
      },
      {
        "command": "sessionFinder.openInTab",
        "title": "Claude: Open Session in Tab"
      },
      {
        "command": "sessionFinder.openInRightPanel",
        "title": "Claude: Open Session in Right Panel"
      },
      {
        "command": "sessionFinder.openSessionView",
        "title": "Claude: Open Session View"
      },
      {
        "command": "sessionFinder.closeSession",
        "title": "Claude: Close Session"
      }
    ],
    "configuration": {
      "title": "Claude Code Sessions",
      "properties": {
        "sessionFinder.defaultWindow": {
          "type": "string",
          "default": "60d",
          "description": "Default recency window for searches, e.g. 30d, 60d, all. Exact-identifier queries such as pr:123 ignore it entirely. Widen any search inline with since:all."
        },
        "sessionFinder.sidebarScope": {
          "type": "string",
          "enum": ["workspace", "all"],
          "default": "workspace",
          "enumDescriptions": [
            "Only sessions from this workspace's folders, their git repository and all of its worktrees.",
            "Every Claude Code session on this machine."
          ],
          "description": "Which sessions the Sessions view lists. The filter button in the view toggles it per workspace; the status bar and the search picker always cover every project."
        },
        "sessionFinder.contextBudget": {
          "type": "number",
          "default": 1000000,
          "minimum": 1000,
          "description": "Tokens of context at which a session's cost meter reads full (deep red). Set it to where Claude Code compacts for your models; the meter ramps green → yellow → orange → red toward it."
        },
        "sessionFinder.activeWindow": {
          "type": "string",
          "default": "4h",
          "pattern": "^\\s*\\d+\\s*[hdwm]?\\s*$",
          "description": "Sessions written within this window, or open in a Claude Code tab in this window, are ACTIVE and show a live state (running / needs you). Examples: 2h, 8h, 1d. A session kept there only by its tab wears a tag saying how long it has been quiet (\"> 19 h\") so you can close it yourself; everything else, and any session you close from the view, is listed under Closed."
        },
        "sessionFinder.toolQuietSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 5,
          "description": "A session that has been waiting on a tool call for longer than this is shown as \"waiting on a tool or a permission prompt\". On Linux a command that is still running keeps the spinner however long it runs; elsewhere, raise this if your tests or builds run long."
        },
        "sessionFinder.stalledMinutes": {
          "type": "number",
          "default": 15,
          "minimum": 1,
          "description": "A session whose model has written nothing for this long is shown as stalled. Long answers are normal for several minutes, which is why the default is not lower."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sessionFinder",
          "title": "Claude Code Sessions",
          "icon": "resources/sessions.svg"
        }
      ]
    },
    "views": {
      "sessionFinder": [
        {
          "type": "webview",
          "id": "sessionFinder.live",
          "name": "Sessions",
          "contextualTitle": "Claude Code Sessions",
          "icon": "resources/sessions.svg"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "sessionFinder.filterSessions",
          "when": "view == sessionFinder.live",
          "group": "navigation@1"
        },
        {
          "command": "sessionFinder.showAllProjects",
          "when": "view == sessionFinder.live && sessionFinder.scope == workspace",
          "group": "navigation@2"
        },
        {
          "command": "sessionFinder.showThisWorkspace",
          "when": "view == sessionFinder.live && sessionFinder.scope == all",
          "group": "navigation@2"
        },
        {
          "command": "sessionFinder.refresh",
          "when": "view == sessionFinder.live",
          "group": "navigation@3"
        }
      ]
    },
    "keybindings": [
      {
        "command": "sessionFinder.search",
        "key": "ctrl+alt+s",
        "mac": "cmd+alt+s"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "pretest": "npm run check:fixtures",
    "test": "vitest run",
    "test:e2e": "tsc -p tsconfig.e2e.json && node out/test-e2e/runTest.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test --ext .ts",
    "check:fixtures": "node scripts/check-fixtures.mjs test/fixtures",
    "vscode:prepublish": "node esbuild.mjs --no-sourcemap",
    "package": "npx --no @vscode/vsce package --no-dependencies",
    "try": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/try-local.mjs",
    "try:done": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/try-local.mjs --done",
    "publish:ovsx": "ovsx publish -p $OVSX_TOKEN",
    "publish:vsce": "vsce publish"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.94.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vscode/codicons": "^0.0.46-24",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.21.0",
    "eslint": "^8.57.0",
    "glob": "^13.0.6",
    "mocha": "^11.8.0",
    "ovsx": "^1.1.1",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
